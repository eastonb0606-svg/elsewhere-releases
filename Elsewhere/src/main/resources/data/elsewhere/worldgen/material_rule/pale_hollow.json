                    "type": "minecraft:biome",
                    "biome_is": [
                      "elsewhere:resin_bog"
                    ]
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:mud"
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "minecraft:dirt"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:vertical_gradient",
        "random_name": "elsewhere:tuff",
        "true_at_and_below": {
          "absolute": 0
        },
        "false_at_and_above": {
          "absolute": 8
        }
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:tuff"
      }
    }
