	"authors": [],
	"license": "All Rights Reserved",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.elsewhere.boss_ui.DevEntry"],
		"client": ["dev.elsewhere.boss_ui.BossUiClient"]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		{ "config": "elsewhere_boss_ui.mixins.json", "environment": "client" }
	]
}
